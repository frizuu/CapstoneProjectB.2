{
  "info": {
    "name": "Legacy Banking Transactions Demo",
    "_postman_id": "b7b3d5f4-811d-4c0a-a0c2-9aded9ea9151",
    "description": "Demo collection for many transaction flows against the legacy AS/400-style payment system.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "user_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "merchant_code",
      "value": "NMID877996734914",
      "type": "string"
    },
    {
      "key": "amount",
      "value": "50000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Get All Merchants",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/merchants",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "merchants"
          ]
        }
      }
    },
    {
      "name": "Get User Balance",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/balance?user_id={{user_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "balance"
          ],
          "query": [
            {
              "key": "user_id",
              "value": "{{user_id}}"
            }
          ]
        }
      }
    },
    {
      "name": "Get User Transactions",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/transactions?user_id={{user_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "transactions"
          ],
          "query": [
            {
              "key": "user_id",
              "value": "{{user_id}}"
            }
          ]
        }
      }
    },
    {
      "name": "QRIS Inquiry",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/qris/inquiry?merchant_code={{merchant_code}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "qris",
            "inquiry"
          ],
          "query": [
            {
              "key": "merchant_code",
              "value": "{{merchant_code}}"
            }
          ]
        }
      }
    },
    {
      "name": "Payment Request",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"user_id\": {{user_id}},\n  \"amount\": {{amount}}\n}"
        },
        "url": {
          "raw": "{{base_url}}/payment",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "payment"
          ]
        }
      }
    },
    {
      "name": "QRIS Payment Request",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"user_id\": {{user_id}},\n  \"merchant_code\": \"{{merchant_code}}\",\n  \"amount\": {{amount}}\n}"
        },
        "url": {
          "raw": "{{base_url}}/qris/payment",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "qris",
            "payment"
          ]
        }
      }
    }
  ]
}
